# ─────────────────────────────────────────────
#  Vyapaar Vikash – Backend Environment Config
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# Flask secret key — any long random string (used for sessions)
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Google OAuth2 credentials
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create "OAuth 2.0 Client ID" → Web Application
# Add authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend origin for CORS (where your HTML is served from)
FRONTEND_ORIGIN=http://localhost:8080


# Database – PostgreSQL in production (tables are managed with SQLAlchemy + Alembic).
# Leave DATABASE_URL empty to fall back to the local SQLite file in DATABASE_PATH.
DATABASE_URL=postgresql+psycopg://vyapar:change-me@localhost:5432/vyapar
DATABASE_PATH=database/db.sqlite3

# Flask debug mode (never enable on a publicly reachable server)
FLASK_DEBUG=0

# AI advisor – any OpenAI-compatible chat API with tool calling.
# Leave LLM_API_KEY empty to keep the rule-based advisor.
#   OpenAI : LLM_BASE_URL empty,                                         LLM_MODEL=gpt-4o-mini
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1,                LLM_MODEL=llama-3.3-70b-versatile
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, LLM_MODEL=gemini-2.0-flash
#   Ollama : LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOOL_ROUNDS=6
AI_ADVISOR_RATE_LIMIT_PER_MIN=20
AI_TOOLS_RATE_LIMIT_PER_MIN=60
# Set to 1 when running behind a reverse proxy or Cloudflare tunnel so rate limits use the real client IP
TRUST_PROXY=0
# Proxies allowed to set X-Forwarded-For / CF-Connecting-IP (comma-separated IPs or CIDRs)
TRUSTED_PROXIES=127.0.0.1/32,::1/128

