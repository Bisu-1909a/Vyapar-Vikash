# ─────────────────────────────────────────────
#  Vyapaar Vikash – Backend Environment Config
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# Flask secret key — any long random string (used for sessions)
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Google OAuth2 credentials
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create "OAuth 2.0 Client ID" → Web Application
# Add authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend origin for CORS (where your HTML is served from)
FRONTEND_ORIGIN=http://localhost:8080


# SQLite database path (relative to project root or dedicated database/ folder)
DATABASE_PATH=database/db.sqlite3

